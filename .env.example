# ==========================================
# PRISM Environment Variables Configuration
# Copy this file to .env and fill in your values.
# ==========================================

# ── Backend Configuration ─────────────────
# Python runtime version on Render
PYTHON_VERSION=3.11.9

# Server Port (Render sets $PORT dynamically; for local dev, defaults to 8001)

# CORS: Allowed Frontend Origin(s) for production (comma-separated if multiple)
FRONTEND_URL=https://your-app.vercel.app

# Backend Public URL (accessible by Agora Webhook / LLM Proxy)
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# ── Agora Realtime Credentials ────────────
# Obtain from https://console.agora.io
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ── LLM Provider Configuration ────────────
# OpenAI-compatible API Endpoint (Groq, OpenAI, Together, Anyscale, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# ── Frontend Configuration ────────────────
# Set in Vercel environment variables or frontend/.env
VITE_API_URL=https://your-backend.onrender.com

# LiteLLM fallback (if primary LLM fails during demo)
LITELLM_FALLBACK_MODEL=
LITELLM_FALLBACK_API_KEY=
LITELLM_FALLBACK_API_BASE=
# Faster Whisper model size: tiny/base/small/medium/large-v3
# medium = best balance of speed+accuracy for Hindi/Hinglish on CPU
WHISPER_MODEL_SIZE=medium

# Agora agent idle timeout in seconds (default: 60)
AGORA_IDLE_TIMEOUT=60

# TTS Configuration
# Agora Conversational AI handles TTS natively via its built-in voice engine.
# To use an external TTS provider, configure via Agora agent payload in /session/start.
# TTS_VENDOR=agora  (default — uses Agora built-in)

# ── Authentication ────────────────────────────────────────────────────
# Agent login credentials (demo only — use a real auth provider in production)
AGENT_USERNAME=agent
AGENT_PASSWORD=prism2024
JWT_SECRET=change-this-in-production

# Debug endpoints (set to "true" ONLY in development)
ENABLE_DEBUG_ENDPOINTS=false

# LLM Proxy security (shared secret between Agora and your backend)
# Set this to a random string; configure the same value in Agora Conversational AI settings
AGORA_LLM_PROXY_SECRET=

# ── Database ──────────────────────────────────────────────────────────────
# SQLite database path (relative to backend directory)
# For production: use PostgreSQL connection string
DATABASE_URL=prism.db
