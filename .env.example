# Agora Credentials
# Get these from https://console.agora.io
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Agora RESTful API credentials (NOT the same as App ID/Certificate)
# Find under Console > RESTful API
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# LLM Provider (OpenAI-compatible endpoint)
LLM_API_KEY=sk-your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# TTS: Using Agora native TTS (no external key required)
# Agora provides TTS built-in — no Azure or ElevenLabs key needed

# Backend public URL (required for Agora to call your LLM proxy)
# For local dev with ngrok: https://xxxx.ngrok.io
# For deployment: https://your-domain.com
BACKEND_PUBLIC_URL=http://localhost:8000
