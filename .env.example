# ==========================================
# PRISM Environment Variables Configuration
# Copy this file to .env and fill in your values.
# ==========================================

# ── Backend Configuration ─────────────────
# Server Port (Render sets this dynamically via $PORT)
PORT=8001

# CORS: Allowed Frontend Origin(s) for production (comma-separated if multiple)
FRONTEND_URL=https://your-app.vercel.app

# Backend Public URL (accessible by Agora Webhook / LLM Proxy)
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# ── Agora Realtime Credentials ────────────
# Obtain from https://console.agora.io
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ── LLM Provider Configuration ────────────
# OpenAI-compatible API Endpoint (Groq, OpenAI, Together, Anyscale, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# ── Frontend Configuration ────────────────
# Set in Vercel environment variables or frontend/.env
VITE_API_URL=https://your-backend.onrender.com
